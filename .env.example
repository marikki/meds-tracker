# Скопіювати в .env і заповнити. .env у git не потрапляє.

# Підпис сесійних cookie: openssl rand -hex 32
JWT_SECRET=

# Користувачі: PASSWORD_<ІМ'Я> → id "<ім'я>" у нижньому регістрі.
# Пароль — випадковий, від 16 символів: openssl rand -base64 24
PASSWORD_MARINA=
# Відображуване ім'я (необов'язково)
NAME_MARINA=Марина
